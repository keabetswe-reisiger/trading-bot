# Copy this file to ".env" and fill in your Alpaca PAPER TRADING keys.
# Get them from: https://app.alpaca.markets/paper/dashboard/overview
# NEVER commit the real ".env" file or share these keys.

ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_key_here
ALPACA_PAPER=true

# Comma-separated list of symbols to scalp
SYMBOLS=AAPL,MSFT

# Risk settings
RISK_PER_TRADE_PCT=1.0
DAILY_LOSS_LIMIT_PCT=3.0
MAX_OPEN_POSITIONS=2
# Skip symbols averaging fewer shares/minute than this over the last 10 bars
MIN_AVG_VOLUME=2000

# Scalp exit settings
# STOP_MODE=atr sizes the stop to each symbol's own recent volatility (recommended).
# STOP_MODE=pct uses a fixed percent off entry for both take-profit and stop-loss.
STOP_MODE=atr
TAKE_PROFIT_PCT=0.3
STOP_LOSS_PCT=0.15
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
REWARD_RISK_RATIO=2.0
MAX_HOLD_MINUTES=10

# How often the bot checks for new signals, in seconds
POLL_INTERVAL_SECONDS=60

# ============================================================
# Gold bot (main_gold.py) — OANDA XAU_USD, separate from the stock settings above.
# Get a free practice account + API token: https://www.oanda.com/demo-account/
# ============================================================
OANDA_API_TOKEN=your_oanda_practice_token_here
OANDA_ACCOUNT_ID=your_oanda_practice_account_id_here
OANDA_ENVIRONMENT=practice

GOLD_INSTRUMENT=XAU_USD
# "stophunt" (default, validated on 3 weeks), "breakout" (continuation trigger,
# strong on a small 17-trade sample, not yet validated further), "quality"
# (stop-hunt/breakout + candle confirm + VSA volume confirm - best avg R and
# best spread-cost survival found so far, but relies on has_stopping_volume()
# which is unvalidated against OANDA's tick volume, so not the default),
# "pullback", "divergence", or "crossover"
GOLD_ENTRY_MODE=stophunt
# Only take gold signals during London/NY hours (07:00-20:00 UTC) — the overnight
# Asian session showed thin, choppy tick volume in testing.
GOLD_RESTRICT_SESSION=true
# Requires an engulfing candle or pin bar on the trigger bar (only applies when
# ENTRY_MODE=stophunt) — best-tested combination so far, only validated on one week.
GOLD_REQUIRE_CANDLE_CONFIRM=true
# Only applies when ENTRY_MODE=quality — see config_gold.py.
GOLD_QUALITY_VOLUME_MULTIPLIER=1.5
GOLD_RISK_PER_TRADE_PCT=1.0
GOLD_DAILY_LOSS_LIMIT_PCT=3.0
# 0 = disabled. Stop trading for the day after this many losses in a row.
GOLD_MAX_CONSECUTIVE_LOSSES=2
# 0 = disabled. Safety cap: position notional value can't exceed this % of equity.
GOLD_MAX_POSITION_VALUE_PCT=500
GOLD_MAX_OPEN_POSITIONS=1
GOLD_MIN_AVG_VOLUME=0

# Live safety guard: skip a fired signal if the current bid/ask spread
# exceeds this (price units). Not backtestable — no historical bid/ask data
# exists for GC=F — but $0.50 sits between README's own "$0.40 = typical"
# and "$1.00 = wide, kills the edge" spread-cost test bracket.
GOLD_MAX_SPREAD=0.50

GOLD_STOP_MODE=atr
GOLD_TAKE_PROFIT_PCT=0.3
GOLD_STOP_LOSS_PCT=0.15
GOLD_ATR_PERIOD=14
GOLD_ATR_STOP_MULTIPLIER=1.5
GOLD_REWARD_RISK_RATIO=2.0
GOLD_MAX_HOLD_MINUTES=10

GOLD_POLL_INTERVAL_SECONDS=30

# ============================================================
# Gold position bot (main_gold_position.py) — genuine multi-day swing
# trading on daily bars, holds of days-to-weeks. USE A SEPARATE OANDA
# PRACTICE ACCOUNT from OANDA_API_TOKEN/OANDA_ACCOUNT_ID above — running
# both bots against the same account means they'd fight over the same
# XAU_USD position slot. See README.md's "Genuine multi-day swing/position
# trading" section for the backtest that validated this.
# ============================================================
OANDA_POSITION_API_TOKEN=your_second_oanda_practice_token_here
OANDA_POSITION_ACCOUNT_ID=your_second_oanda_practice_account_id_here
OANDA_POSITION_ENVIRONMENT=practice

POSITION_INSTRUMENT=XAU_USD
# "divergence" (default, validated) or "breakout" (also held up in
# validation, less consistent train->test match)
POSITION_ENTRY_MODE=divergence
POSITION_RISK_PER_TRADE_PCT=1.0
POSITION_DAILY_LOSS_LIMIT_PCT=3.0
POSITION_MAX_OPEN_POSITIONS=1
POSITION_MAX_CONSECUTIVE_LOSSES=2
POSITION_MAX_POSITION_VALUE_PCT=500

# Most conservative validated config (see README.md for the full
# train/test comparison table) — train avg R 0.39 -> held-out test avg R
# 0.32, 55.6% win rate, 3.48% max drawdown on the held-out period.
POSITION_ATR_PERIOD=14
POSITION_ATR_STOP_MULTIPLIER=2.5
POSITION_REWARD_RISK_RATIO=2.0
POSITION_MAX_HOLD_DAYS=20

# Checked every 6 hours by default, not continuously — a daily strategy
# has nothing new to see between one day's close and the next.
POSITION_POLL_INTERVAL_SECONDS=21600
